+/// Whether `RAPIER_STABLE_EPOCH` is set to something other than `0` (read once).
+pub(crate) fn stable_epoch_on() -> bool {
+    #[cfg(feature = "std")]
+    {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ON.get_or_init(|| std::env::var("RAPIER_STABLE_EPOCH").is_ok_and(|v| v.trim() != "0"))
+    }
+    #[cfg(not(feature = "std"))]
+    {
+        false
+    }
+}
