+
+    /// TABPerf: prefetches the list links of the first edges of node `a`'s two lists (reads the
+    /// node, which should be prefetched beforehand).
+    #[inline]
+    pub(crate) fn prefetch_list_heads(&self, a: NodeIndex) {
+        if let Some(node) = self.nodes.get(a.index()) {
+            for e in node.next {
+                if e.index() < self.edges.len() {
+                    let edge = unsafe { self.edges.as_ptr().add(e.index()) };
+                    crate::utils::prefetch_read::<0, _>(unsafe { &raw const (*edge).next });
+                }
+            }
+        }
+    }
