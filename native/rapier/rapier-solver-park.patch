+
+/// Spins before a waiting worker parks, from the `RAPIER_SYNC_SPIN` environment variable (read
+/// once). 0 (unset): spin, yielding every 10,000 spins, never parking. Spinning workers keep
+/// their cores busy while other threads of the process (a game's logic and rendering) could use
+/// them; parking hands the core back at the price of a wake-up per stage.
+#[cfg(feature = "std")]
+fn sync_spin_limit() -> u32 {
+    use core::sync::atomic::AtomicU32;
+    static LIMIT: AtomicU32 = AtomicU32::new(u32::MAX);
+    let v = LIMIT.load(Ordering::Relaxed);
+    if v != u32::MAX {
+        return v;
+    }
+    let n = std::env::var("RAPIER_SYNC_SPIN")
+        .ok()
+        .and_then(|s| s.trim().parse::<u32>().ok())
+        .filter(|&n| n < u32::MAX)
+        .unwrap_or(0);
+    LIMIT.store(n, Ordering::Relaxed);
+    n
 }
 
