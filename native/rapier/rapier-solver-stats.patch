+/// Number of values rpr_solver_diag writes.
+pub const RPR_SOLVER_DIAG_COUNT: usize = 9;
+
+/// Staged-solver diagnostics summed since the previous call, then reset (recorded only while the
+/// RAPIER_SOLVER_DIAG environment variable is set): 0 barrier wait ns (all workers), 1 barrier
+/// waits, 2 worker-0 serial overflow ns, 3 worker run ns (all workers), 4 colors, 5 overflow
+/// chunks, 6 chunks, 7 workers, 8 solves (4-7 summed per solve).
+/// @ingroup worlds
+#[rapier_export]
+pub unsafe extern "C" fn rpr_solver_diag(buffer: *mut f64, capacity: usize, count: *mut usize) -> RprStatus {
+    ffi(|| unsafe {
+        let d = rapier::counters::solver_diag_take();
+        let values: [f64; RPR_SOLVER_DIAG_COUNT] = core::array::from_fn(|k| d[k] as f64);
+        copy_out(&values, buffer, capacity, count)
+    })
+}
