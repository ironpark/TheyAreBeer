@@ -9,6 +9,92 @@ pub use self::solver_counters::SolverCounters;
 pub use self::stages_counters::StagesCounters;
 pub use self::timer::Timer;
 
+/// Staged-solver diagnostics (TABPerf), summed until [`solver_diag_take`], recorded only while the
+/// `RAPIER_SOLVER_DIAG` environment variable is set: 0 barrier wait ns (all workers), 1 barrier
+/// waits, 2 worker-0 serial overflow ns, 3 worker run ns (all workers), 4 colors, 5 overflow
+/// chunks, 6 chunks, 7 workers, 8 solves. Serial sections (ns), timed with [`DiagLap`]: velocity assembly
+/// 9 buffers & solver bodies, 10 joints, 11 chunk layout, 12 constraint buffers & generic, 13 stats;
+/// narrow phase 14 user changes, 15 register pairs, 16 awake mask & candidates, 17 pair update
+/// (parallel), 18 transitions, 19 intersections; constraint collection 20 solver graph, 21 joints.
+/// Counts: 22 broad-phase pair adds, 23 pair removals, 24 solver-graph full rebuilds, 25 pairs
+/// fully updated (reconciled when not rebuilding); solver graph sections (ns): 26 body table, 27 buckets.
+/// Rebuild causes (counts): 28 graph invalidated, active-set epoch bumps by 29 body updated, 30 body
+/// removed or disabled, 31 bodies put to sleep, 32 bodies woken, 33 substep groups. Body updates
+/// (counts, not exclusive): 34 fixed, 35 sleep flag, 36 type or enabled changed, 37 not in an island
+/// yet, 38 colliders / mass / dominance changed, 39 all. Pair registration (ns): 40 adds; removals
+/// 41 lookups, 42 edge find & unlink, 43 solver graph & force list, 44 swap-remove & relink,
+/// 45 moved edge fixup, 46 persistent islands, 47 colors, wake-up, retire. Pair adds (ns): 48 graph
+/// indices, 49 nodes & edge lookup, 50 pair from pool or new. Pairs added from the pool: 51.
+pub const SOLVER_DIAG_COUNT: usize = 52;
+static SOLVER_DIAG: [core::sync::atomic::AtomicU64; SOLVER_DIAG_COUNT] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; SOLVER_DIAG_COUNT];
+
+/// Whether the solver diagnostics are recorded (read once).
+pub fn solver_diag_on() -> bool {
+    #[cfg(feature = "std")]
+    {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("RAPIER_SOLVER_DIAG").is_some())
+    }
+    #[cfg(not(feature = "std"))]
+    {
+        false
+    }
+}
+/// Adds `v` to diagnostic `k` (when recording).
+pub fn solver_diag_add(k: usize, v: u64) {
+    if solver_diag_on() {
+        SOLVER_DIAG[k].fetch_add(v, core::sync::atomic::Ordering::Relaxed);
+    }
+}
+/// A start time for [`solver_diag_since`], `None` when not recording.
+#[cfg(feature = "std")]
+pub fn solver_diag_start() -> Option<std::time::Instant> {
+    solver_diag_on().then(std::time::Instant::now)
+}
+/// Adds the nanoseconds since `start` to diagnostic `k`.
+#[cfg(feature = "std")]
+pub fn solver_diag_since(k: usize, start: Option<std::time::Instant>) {
+    if let Some(t) = start {
+        add_ns(k, t, std::time::Instant::now());
+    }
+}
+#[cfg(feature = "std")]
+fn add_ns(k: usize, from: std::time::Instant, to: std::time::Instant) {
+    SOLVER_DIAG[k].fetch_add((to - from).as_nanos() as u64, core::sync::atomic::Ordering::Relaxed);
+}
+/// Returns the diagnostics and resets them.
+pub fn solver_diag_take() -> [u64; SOLVER_DIAG_COUNT] {
+    core::array::from_fn(|k| SOLVER_DIAG[k].swap(0, core::sync::atomic::Ordering::Relaxed))
+}
+/// Consecutive serial sections: each [`DiagLap::lap`] adds the time since the previous lap (or the
+/// start) to a diagnostic. Does nothing when not recording.
+pub struct DiagLap(#[cfg(feature = "std")] Option<std::time::Instant>);
+impl DiagLap {
+    /// Starts timing (when recording).
+    pub fn start() -> Self {
+        #[cfg(feature = "std")]
+        {
+            DiagLap(solver_diag_start())
+        }
+        #[cfg(not(feature = "std"))]
+        {
+            DiagLap()
+        }
+    }
+    /// Adds the time since the previous lap to diagnostic `k`.
+    pub fn lap(&mut self, k: usize) {
+        #[cfg(feature = "std")]
+        if let Some(t) = self.0 {
+            let now = std::time::Instant::now();
+            add_ns(k, t, now);
+            self.0 = Some(now);
+        }
+        #[cfg(not(feature = "std"))]
+        let _ = k;
+    }
+}
