index 3879285..e791957 100644
--- a/src/dynamics/solver/staged_island_solver/init.rs
+++ b/src/dynamics/solver/staged_island_solver/init.rs
@@ -332,16 +332,64 @@ impl StagedIslandSolver {
                 *next_chunk += refs.len().div_ceil(SIMD_WIDTH);
             };
 
-        if self.groups.len() == 1 {
-            // Single group (the common case): the historical zero-copy layout,
-            // slicing the persistent buckets directly.
+        if self.groups.len() == 1 && crate::counters::contact_sort_on() {
+            // TABPerf (RAPIER_CONTACT_SORT): each parallel color's refs copied and sorted by their
+            // lowest solver-body slot, so consecutive chunks gather/scatter nearby bodies. Same-color
+            // constraints touch pairwise-disjoint bodies, so their order within the color (and the
+            // SIMD lane grouping) does not change any result. Reserved up front: segments hold raw
+            // pointers into the vec, which must not reallocate.
+            self.grouped_chunk_refs.reserve(num_two_body);
+            let cap = self.grouped_chunk_refs.capacity();
+            let mut runs: Vec<(u8, usize, usize)> = Vec::new();
             for (color, refs) in graph.buckets() {
                 if (color as usize) < NUM_COLORS - 1
                     && refs.len().div_ceil(SIMD_WIDTH) >= min_color_chunks
                 {
-                    let range_start = next_chunk;
-                    push_segment(&mut self.chunk_segments, &mut next_chunk, refs);
-                    self.color_ranges.push((color, range_start..next_chunk));
+                    runs.push((color, self.grouped_chunk_refs.len(), refs.len()));
+                    self.grouped_chunk_refs.extend_from_slice(refs);
+                }
+            }
+            debug_assert_eq!(self.grouped_chunk_refs.capacity(), cap);
+            let key = |r: &ContactRef| -> u32 {
+                let ids = store.get(*r).data.solver_body_ids;
+                ids[0].min(ids[1])
+            };
+            {
+                let mut slices: Vec<&mut [ContactRef]> = Vec::with_capacity(runs.len());
+                let mut rest: &mut [ContactRef] = &mut self.grouped_chunk_refs[..];
+                for &(_, _, len) in &runs {
+                    let (head, tail) = rest.split_at_mut(len);
+                    slices.push(head);
+                    rest = tail;
+                }
+                #[cfg(feature = "parallel")]
+                {
+                    use rayon::prelude::*;
+                    slices.par_iter_mut().for_each(|s| s.sort_by_cached_key(key));
+                }
+                #[cfg(not(feature = "parallel"))]
+                for s in slices.iter_mut() {
+                    s.sort_by_cached_key(key);
+                }
+            }
+            for &(color, start, len) in &runs {
+                let range_start = next_chunk;
+                push_segment(&mut self.chunk_segments, &mut next_chunk, &self.grouped_chunk_refs[start..start + len]);
+                self.color_ranges.push((color, range_start..next_chunk));
+            }
+        }
+        if self.groups.len() == 1 {
+            // Single group (the common case): the historical zero-copy layout,
+            // slicing the persistent buckets directly.
+            if !crate::counters::contact_sort_on() {
+                for (color, refs) in graph.buckets() {
+                    if (color as usize) < NUM_COLORS - 1
+                        && refs.len().div_ceil(SIMD_WIDTH) >= min_color_chunks
+                    {
+                        let range_start = next_chunk;
+                        push_segment(&mut self.chunk_segments, &mut next_chunk, refs);
+                        self.color_ranges.push((color, range_start..next_chunk));
+                    }
                 }
             }
 
