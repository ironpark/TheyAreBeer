@@ -63,6 +63,37 @@ pub fn solver_diag_since(k: usize, start: Option<std::time::Instant>) {
 fn add_ns(k: usize, from: std::time::Instant, to: std::time::Instant) {
     SOLVER_DIAG[k].fetch_add((to - from).as_nanos() as u64, core::sync::atomic::Ordering::Relaxed);
 }
+
+/// TABPerf memory-order switches, read once from the environment: `RAPIER_BODY_SORT=<n>` reorders the
+/// awake bodies along a Morton curve of their positions every `n` steps (0 or unset: never),
+/// `RAPIER_CONTACT_SORT=1` sorts each parallel color's contacts by solver body slot.
+pub fn tabperf_env_u32(name: &'static str, cache: &'static core::sync::atomic::AtomicU32) -> u32 {
+    use core::sync::atomic::Ordering;
+    let v = cache.load(Ordering::Relaxed);
+    if v != u32::MAX {
+        return v;
+    }
+    #[cfg(feature = "std")]
+    let v = std::env::var(name).ok().and_then(|s| s.trim().parse::<u32>().ok()).unwrap_or(0).min(u32::MAX - 1);
+    #[cfg(not(feature = "std"))]
+    let v = {
+        let _ = name;
+        0
+    };
+    cache.store(v, Ordering::Relaxed);
+    v
+}
+/// See [`tabperf_env_u32`].
+pub fn body_sort_period() -> u32 {
+    static C: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(u32::MAX);
+    tabperf_env_u32("RAPIER_BODY_SORT", &C)
+}
+/// See [`tabperf_env_u32`].
+pub fn contact_sort_on() -> bool {
+    static C: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(u32::MAX);
+    tabperf_env_u32("RAPIER_CONTACT_SORT", &C) != 0
+}
+
 /// Returns the diagnostics and resets them.
 pub fn solver_diag_take() -> [u64; SOLVER_DIAG_COUNT] {
     core::array::from_fn(|k| SOLVER_DIAG[k].swap(0, core::sync::atomic::Ordering::Relaxed))
