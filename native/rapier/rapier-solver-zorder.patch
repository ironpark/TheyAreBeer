+impl IslandManager {
+    /// TABPerf: every `RAPIER_BODY_SORT` steps, reorders the awake island's bodies (the solver-body
+    /// slots) along a Morton curve of their positions, so bodies that touch sit near each other in
+    /// the solver arrays: the contact solve gathers and scatters two bodies per contact, and in a
+    /// list kept in island-merge order those are cache misses. Same re-stamp and epoch bump as the
+    /// substep-group reorder (every ordering-derived cache rebuilds). Skipped while solve groups
+    /// exist (they need their own order) and for small sets.
+    pub(crate) fn sort_awake_bodies_spatially(&mut self, bodies: &mut RigidBodySet) {
+        use core::sync::atomic::{AtomicU32, Ordering};
+        static TICK: AtomicU32 = AtomicU32::new(0);
+        let period = crate::counters::body_sort_period();
+        if period == 0 || !self.solve_groups.is_empty() {
+            return;
+        }
+        if TICK.fetch_add(1, Ordering::Relaxed) % period != 0 {
+            return;
+        }
+        let Some(awake_id) = self.awake_island else {
+            return;
+        };
+        let n = self.islands[awake_id].bodies.len();
+        if n < 4096 {
+            return;
+        }
+        let list = &self.islands[awake_id].bodies;
+        let (mut lo, mut hi) = ([f32::MAX; 2], [f32::MIN; 2]);
+        let pos: Vec<[f32; 2]> = list
+            .iter()
+            .map(|h| {
+                let t = bodies[*h].translation();
+                let p = [t.x as f32, t.y as f32];
+                for k in 0..2 {
+                    if p[k].is_finite() {
+                        lo[k] = lo[k].min(p[k]);
+                        hi[k] = hi[k].max(p[k]);
+                    }
+                }
+                p
+            })
+            .collect();
+        let scale = [65535.0 / (hi[0] - lo[0]).max(1e-6), 65535.0 / (hi[1] - lo[1]).max(1e-6)];
+        let spread = |v: u32| -> u64 {
+            let mut x = v as u64 & 0xFFFF;
+            x = (x | (x << 8)) & 0x00FF_00FF;
+            x = (x | (x << 4)) & 0x0F0F_0F0F;
+            x = (x | (x << 2)) & 0x3333_3333;
+            (x | (x << 1)) & 0x5555_5555
+        };
+        let mut keyed: Vec<(u64, u32)> = pos
+            .iter()
+            .enumerate()
+            .map(|(i, p)| {
+                let q = |k: usize| -> u32 {
+                    let v = (p[k] - lo[k]) * scale[k];
+                    if v.is_finite() { v.clamp(0.0, 65535.0) as u32 } else { 0 }
+                };
+                ((spread(q(0)) | (spread(q(1)) << 1)) << 32 | i as u64, i as u32)
+            })
+            .collect();
+        #[cfg(feature = "parallel")]
+        {
+            use rayon::prelude::*;
+            keyed.par_sort_unstable_by_key(|k| k.0);
+        }
+        #[cfg(not(feature = "parallel"))]
+        keyed.sort_unstable_by_key(|k| k.0);
+        // Already in order (nothing moved much since the last sort): keep the slots and the caches.
+        if keyed.iter().enumerate().all(|(i, k)| k.1 as usize == i) {
+            return;
+        }
+        let ws = &mut self.substep_groups_workspace.workspace;
+        ws.clear();
+        ws.extend(keyed.iter().map(|k| list[k.1 as usize]));
+        core::mem::swap(&mut self.islands[awake_id].bodies, ws);
+        for (i, handle) in self.islands[awake_id].bodies.iter().enumerate() {
+            bodies.index_mut_internal(*handle).ids.active_set_id = i as u32;
+        }
+        self.bump_active_set_epoch();
+    }
+}
